CMS_URL=https://cms.example.com
# botcast-cms の API_KEY と同じ値
API_KEY=
ANTHROPIC_API_KEY=
KAFRU_DB_PASSWORD=
MINIO_ROOT_USER=botcast
MINIO_ROOT_PASSWORD=
# ブラウザから到達できる MinIO の URL (署名付き URL に使われる)
S3_PUBLIC_ENDPOINT=http://<docker-host>:9000

