CMS_URL=https://cms.example.com
# botcast-cms の API_KEY と同じ値
API_KEY=
ANTHROPIC_API_KEY=
KAFRU_DB_PASSWORD=

# 任意: worker.env に書く (空文字は渡さないこと)
# ANTHROPIC_MODEL=claude-opus-5-5
# VOICEVOX_ENDPOINT=http://voicevox:50021

# 任意: GHCR イメージのタグ (既定 latest。sha-xxxxxxx で固定できる)
# BOTCAST_TAG=latest

# 任意: watchtower の更新通知先 (shoutrrr 形式)
# Discord の https://discord.com/api/webhooks/<id>/<token> なら discord://<token>@<id>
# WATCHTOWER_NOTIFICATION_URL=
