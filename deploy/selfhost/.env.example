CMS_URL=https://cms.example.com
# botcast-cms のテナント ID (CMS は /t/{tenantId}/... でテナントを識別する)
CMS_TENANT=botcast
# botcast-cms の API_KEY_<TENANT> と同じ値 (キーはテナントごとに発行される)
API_KEY=
ANTHROPIC_API_KEY=
KAFRU_DB_PASSWORD=

# 任意: worker.env に書く (空文字は渡さないこと)
# ANTHROPIC_MODEL=claude-opus-5-5
# VOICEVOX_ENDPOINT=http://voicevox:50021

# 任意: TTS エンジン (worker.env に書く。TTS_ENGINES があれば VOICEVOX_ENDPOINT は読まない)
# KIND は voicevox | openai。TOKEN は bearer トークン。MAX_CONCURRENCY は同時に投げる数 (GPU 1 枚なら 1)
# TTS_DEFAULT_ENGINE は台本の speaker (VOICEVOX のスタイル ID) に使うエンジン (既定: TTS_ENGINES の先頭)
# TTS_CACHE_DIR は合成結果のキャッシュの置き場 (既定: ジョブのワークディレクトリ)
# TTS_ENGINES=voicevox,irodori
# TTS_DEFAULT_ENGINE=voicevox
# TTS_ENGINE_VOICEVOX_KIND=voicevox
# TTS_ENGINE_VOICEVOX_ENDPOINT=http://voicevox:50021
# TTS_ENGINE_IRODORI_KIND=openai
# TTS_ENGINE_IRODORI_ENDPOINT=http://gpu-host:8088/v1
# TTS_ENGINE_IRODORI_TOKEN=
# TTS_ENGINE_IRODORI_MODEL=irodori-tts
# TTS_ENGINE_IRODORI_MAX_CONCURRENCY=1
# TTS_ENGINE_IRODORI_TIMEOUT_SEC=120
# TTS_CACHE_DIR=/var/cache/botcast/tts

# 任意: GHCR イメージのタグ (既定 latest。sha-xxxxxxx で固定できる)
# BOTCAST_TAG=latest

# 任意: watchtower の更新通知先 (shoutrrr 形式)
# Discord の https://discord.com/api/webhooks/<id>/<token> なら discord://<token>@<id>
# WATCHTOWER_NOTIFICATION_URL=
